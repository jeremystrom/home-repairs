---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photo {
  src: ImageMetadata;
  caption?: string;
}
interface Props {
  photos: Photo[];
}
const { photos } = Astro.props;
---
{photos.length > 0 && (
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-6">
    {photos.map(photo => (
      <figure class="bg-white rounded-lg overflow-hidden ring-1 ring-brand-100">
        <a href={photo.src.src} target="_blank" rel="noopener" class="block">
          <Image
            src={photo.src}
            alt={photo.caption ?? 'Inspection photo'}
            width={800}
            height={600}
            class="w-full h-auto object-cover hover:opacity-95 transition"
          />
        </a>
        {photo.caption && (
          <figcaption class="px-3 py-2 text-xs text-gray-600 border-t border-brand-100">
            {photo.caption}
          </figcaption>
        )}
      </figure>
    ))}
  </div>
)}
