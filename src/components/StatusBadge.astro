---
type Status = 'todo' | 'in-progress' | 'done';
interface Props {
  status: Status;
  size?: 'sm' | 'md';
}
const { status, size = 'md' } = Astro.props;

const labels: Record<Status, string> = {
  todo: 'Not started',
  'in-progress': 'In progress',
  done: 'Done',
};

const styles: Record<Status, string> = {
  todo: 'bg-gray-100 text-gray-600 ring-gray-300',
  'in-progress': 'bg-amber-100 text-amber-800 ring-amber-300',
  done: 'bg-emerald-100 text-emerald-800 ring-emerald-300',
};

const dots: Record<Status, string> = {
  todo: 'bg-gray-400',
  'in-progress': 'bg-amber-500',
  done: 'bg-emerald-600',
};

const sizeClasses = size === 'sm' ? 'text-[10px] px-1.5 py-0.5 gap-1' : 'text-xs px-2 py-1 gap-1.5';
---
<span class={`inline-flex items-center font-semibold rounded-full ring-1 ring-inset ${styles[status]} ${sizeClasses}`}>
  {status === 'done' ? (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="w-3 h-3 fill-current">
      <path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 1 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/>
    </svg>
  ) : (
    <span class={`w-1.5 h-1.5 rounded-full ${dots[status]}`} />
  )}
  {labels[status]}
</span>
