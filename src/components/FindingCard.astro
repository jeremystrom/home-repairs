---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SeverityBadge from './SeverityBadge.astro';
import CategoryBadge from './CategoryBadge.astro';

interface Props {
  finding: CollectionEntry<'findings'>;
}
const { finding } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/findings/${finding.data.id}`;
const hero = finding.data.photos[0];
---
<a href={href} class="group block bg-white rounded-lg overflow-hidden ring-1 ring-brand-100 hover:ring-brand-500 hover:shadow-md transition">
  <div class="aspect-[4/3] bg-brand-100 relative overflow-hidden">
    {hero ? (
      <Image
        src={hero.src}
        alt={hero.caption ?? finding.data.title}
        width={400}
        height={300}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-brand-200">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-16 h-16">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
        </svg>
      </div>
    )}
    <div class="absolute top-2 left-2 flex gap-1.5">
      <CategoryBadge category={finding.data.category} />
    </div>
    <div class="absolute top-2 right-2">
      <SeverityBadge severity={finding.data.severity} size="sm" />
    </div>
  </div>
  <div class="p-4">
    <div class="flex items-baseline gap-2 mb-1">
      <span class="text-xs font-mono text-gray-400">{finding.data.id}</span>
      {finding.data.bundleId && (
        <span class="text-[10px] uppercase tracking-wide text-violet-600 font-semibold">Bundled · {finding.data.bundleId}</span>
      )}
    </div>
    <h3 class="font-semibold text-brand-900 group-hover:text-brand-700 leading-tight">
      {finding.data.title}
    </h3>
    <p class="text-sm text-gray-500 mt-1 line-clamp-1">{finding.data.location}</p>
  </div>
</a>
